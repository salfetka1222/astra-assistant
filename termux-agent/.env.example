# Copy this file to .env, fill values locally, then load it with:
# set -a; source .env; set +a
# Never commit real tokens or API keys. .env is ignored by Git.
#
# Cloud OpenAI-compatible endpoint (optional):
CLOUD_BASE_URL=https://api.openai.com/v1
CLOUD_MODEL=
CLOUD_API_KEY=
#
# Or local Ollama OpenAI-compatible endpoint (optional):
LOCAL_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_MODEL=
#
# Telegram bot (optional). Add only chat IDs you trust.
TELEGRAM_BOT_TOKEN=
ALLOWED_CHAT_IDS=
#
# Optional: keep agent file operations inside this directory.
# AGENT_WORKSPACE=/data/data/com.termux/files/home/astra-agent-workspace
